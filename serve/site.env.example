# Copy to serve/site.env (git-ignored) on the cluster. Cluster-specific values never enter the repo.
PARTITION=REPLACE_ME          # GPU partition
QOS=REPLACE_ME                # production QoS (debug QoS only for <3h engineering tests)
VENV=$HOME/envs/collusion     # env with vllm + this package; keep it OFF parallel filesystems with many small files
HF_HOME=REPLACE_ME            # big storage for model weights (~65 GB for R1-32B)
LOGDIR=REPLACE_ME             # where slurm stdout/stderr go
